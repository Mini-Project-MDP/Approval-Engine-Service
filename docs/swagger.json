{
    "swagger": "2.0",
    "info": {
        "description": "Reusable approval workflow engine shared across Mayora internal systems (asset management first). A consuming app's requester_id/user_id are always checked against registered, active participants — the engine never trusts an identity blindly.\nAuth: only POST /requests requires X-API-Key (a consuming application's server-to-server key — never expose it in a browser). Everything else is reached via the internal portal and relies on unguessable UUIDs plus the engine's own \"are you the assigned approver\" check.",
        "title": "Approval Engine API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/applications": {
            "get": {
                "description": "Never includes api_key — this is a read view for the management UI, not a way to recover a lost key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "applications"
                ],
                "summary": "List consuming applications",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Items per page (default 20, max 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_pkg_response.Page"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            },
            "post": {
                "description": "Generates a new X-API-Key for the application. The key is only ever returned in this one response — List never includes it, so it must be copied to the consuming app's config immediately. callback_url is optional: if set, the engine POSTs a signed webhook there on every request/step state change (see WebhookEvent); if left empty the app can still always poll GET /requests/{id}. No role gate yet (accepted gap for the demo scope).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "applications"
                ],
                "summary": "Register a consuming application",
                "parameters": [
                    {
                        "description": "Application to register",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.CreateApplicationBody"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "includes api_key, shown once",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_internal_domain.Application"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "validation error or duplicate code",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/assignments/{id}/qr": {
            "get": {
                "description": "PNG QR code encoding a signed verify link for this assignment, meant to be printed on a paper document as a \"signature\" stamp. Not a certified/legally-binding e-signature — a tamper-evident proof that an approval genuinely happened in this engine.",
                "produces": [
                    "image/png"
                ],
                "tags": [
                    "signature"
                ],
                "summary": "Approval stamp QR code",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Assignment ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "image/png",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "assignment not found",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/inbox/{userID}": {
            "get": {
                "description": "Everything pending this approver's decision, across every consuming application — the \"one inbox for every system\" promise of a centralized approval portal.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inbox"
                ],
                "summary": "Approver inbox",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Approver NIK",
                        "name": "userID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Items per page (default 20, max 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_pkg_response.Page"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/participants": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "participants"
                ],
                "summary": "List participants",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Items per page (default 20, max 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_pkg_response.Page"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/participants/import": {
            "post": {
                "description": "Upserts by user_id (NIK) in one transaction — a partial failure never leaves the table half-updated. Rows may reference a superior_id that appears later in the same array (or not at all yet); foreign keys are deferred to commit time, so the array does not need to be topologically sorted.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "participants"
                ],
                "summary": "Import participants (e.g. from a FICOM export)",
                "parameters": [
                    {
                        "description": "Participants to import",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.ImportBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/requests": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Starts a new request against the calling application's currently active workflow for doc_type. Idempotent on (app, doc_type, resource_id): calling it again with the same values returns the existing request instead of erroring, so a Spring Boot caller can safely retry on timeout. requester_id must be a registered, active participant.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "requests"
                ],
                "summary": "Create an approval request",
                "parameters": [
                    {
                        "description": "Request to create",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.CreateRequestBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "already existed (idempotent replay)",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_internal_domain.ApprovalRequest"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "201": {
                        "description": "created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_internal_domain.ApprovalRequest"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "validation error or unregistered requester",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    },
                    "401": {
                        "description": "missing or invalid X-API-Key",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/requests/{id}": {
            "get": {
                "description": "Full request with materialized steps and assignment snapshots. Not gated behind an API key: both the consuming app and the approver portal need to read this, and the id itself is an unguessable UUID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "requests"
                ],
                "summary": "Get a request",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Request ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_internal_domain.ApprovalRequest"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/requests/{id}/decision": {
            "post": {
                "description": "The engine enforces that user_id is the person assigned to the currently active step (and still an active participant) — this handler does not independently verify the caller's identity beyond that.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "requests"
                ],
                "summary": "Approve or reject the active step",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Request ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Decision",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.DecisionBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_internal_domain.ApprovalRequest"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "not the assigned approver, already decided, or invalid decision",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/verify/{id}": {
            "get": {
                "description": "Public: confirms the HMAC code is genuine, then reports the assignment's real, live status (never trusts the code alone for the actual decision).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "signature"
                ],
                "summary": "Verify an approval stamp",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Assignment ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "HMAC signature from the QR code",
                        "name": "sig",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    },
                    "403": {
                        "description": "invalid or tampered signature",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    },
                    "404": {
                        "description": "assignment not found",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/workflows": {
            "get": {
                "description": "Every version of every workflow (optionally filtered by app_id), for the management list view.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "List workflows",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by application ID",
                        "name": "app_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Items per page (default 20, max 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_pkg_response.Page"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            },
            "post": {
                "description": "Always inserts a brand new version and atomically deactivates every other version of (app_id, doc_type) — same call whether the pair is new or already exists. In-flight requests keep running against the exact version they started with. Each step's resolver_rule/condition is validated immediately (unknown type, missing field, bad operator all fail here, not silently at resolve time).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Publish a workflow (create or edit)",
                "parameters": [
                    {
                        "description": "Workflow to publish",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.PublishWorkflowBody"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_internal_domain.WorkflowDefinition"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "validation error",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/workflows/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Get a workflow version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workflow definition ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/approval-engine-service_internal_domain.WorkflowDefinition"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        },
        "/workflows/{id}/deactivate": {
            "post": {
                "description": "Stops the version from being used for new requests. Never a hard delete — past requests still reference this definition_id and must stay readable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Deactivate a workflow version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workflow definition ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/approval-engine-service_pkg_response.Envelope"
                        }
                    }
                }
            }
        }
    },
