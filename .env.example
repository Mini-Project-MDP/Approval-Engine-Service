APP_ENV=development
APP_PORT=8000

# Turso (libsql). Required.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Development only: drop and recreate all tables on startup.
DB_RESET=false

ALLOWED_ORIGINS=http://localhost:5173

# Embedded in the QR/verify link printed on documents. Must be a URL
# reachable by whoever scans it (e.g. your ngrok/deployed URL for a demo).
PUBLIC_BASE_URL=http://localhost:8000

# Signs the QR/barcode "signature" stamp (see internal/service/signature.go).
# Required outside development. Never commit the real value.
VERIFICATION_SECRET=
